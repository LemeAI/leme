{
  "version": "0.2.0",
  "configurations": [
    {
      // Sobe o backend sob o debugger. Sem --reload de propósito: o
      // reloader do uvicorn roda a app num processo filho, e breakpoints
      // colocados no processo pai não pegam lá. Para iteração rápida sem
      // breakpoints, use o terminal mesmo (ver leme-app-backend/README.md).
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.presentation.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/leme-app-backend",
      "python": "${workspaceFolder}/leme-app-backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/leme-app-backend/.env",
      "console": "integratedTerminal",
      // Permite entrar no código de FastAPI/SQLAlchemy ao investigar,
      // não só no código do projeto.
      "justMyCode": false
    },
    {
      "name": "Backend: pytest (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "cwd": "${workspaceFolder}/leme-app-backend",
      "python": "${workspaceFolder}/leme-app-backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Backend: arquivo atual",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/leme-app-backend",
      "python": "${workspaceFolder}/leme-app-backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/leme-app-backend/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Next.js dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (backend + frontend)",
      "configurations": ["Backend: FastAPI (debug)", "Frontend: Next.js dev"],
      "stopAll": true
    }
  ]
}
