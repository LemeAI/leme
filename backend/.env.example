# Postgres do Supabase, conectando com a role de baixo privilégio
# leme_backend (criada pela migration 0002) — NÃO use a role postgres, que é
# superuser. A senha é a que você definiu em LEME_BACKEND_DB_PASSWORD ao
# rodar as migrations. O backend reescreve postgres:// / postgresql:// para
# postgresql+asyncpg:// automaticamente.
SUPABASE_DB_URL=postgresql://leme_backend:sua-senha@db.your-project.supabase.co:5432/postgres

# Senha da role leme_backend. Lida apenas pela migration 0002 na hora de
# criar a role; depois disso, o que vale é a senha embutida no
# SUPABASE_DB_URL acima.
LEME_BACKEND_DB_PASSWORD=sua-senha

# Base URL e service-role key do projeto Supabase, usadas só para alcançar a
# API REST de Storage (o banco é acessado via SUPABASE_DB_URL, não pelas
# bibliotecas cliente do Supabase).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=html-files

# Stripe (ver seção Billing no SETUP.md).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTH=price_...
STRIPE_PRICE_ID_YEAR=price_...

# Origem do frontend Next.js (allow-list de CORS + URLs de redirect do
# Stripe) e URL pública do site usada para montar links de compartilhamento.
# Normalmente o mesmo valor.
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# "development" também libera http://localhost:3000 no CORS, independente do
# FRONTEND_URL. Use "production" depois do deploy.
ENVIRONMENT=development

# Onde os contadores de rate limit vivem. O default "memory://" é por
# processo: zera em cold start e não é compartilhado entre instâncias do
# Cloud Run — ou seja, em produção equivale a não ter limite. Aponte para um
# Redis (ex: redis://10.0.0.3:6379) para um limite de verdade.
RATE_LIMIT_STORAGE_URI=memory://

# Quantos proxies reversos existem na frente da app. O IP do cliente é lido
# do X-Forwarded-For contando essa quantidade de entradas a partir da
# direita. Cloud Run sem load balancer = 1.
TRUSTED_PROXY_HOPS=1

# Teto do corpo da request, rejeitado antes de qualquer parsing. Fica acima
# do limite de 2MB por arquivo para dar folga ao overhead de multipart/JSON.
MAX_REQUEST_BYTES=8388608
